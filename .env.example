# Mapbox Static Images + Geocoding API token (optional).
# Used by src/rendering/plan_sheet.py to embed an aerial context tile in
# the generated PDF, and by the Streamlit sidebar to resolve a street
# address to coordinates. If unset, the aerial embed is skipped.
#
# Get a free token at https://account.mapbox.com/ (50,000 requests/month
# free tier is more than enough).
MAPBOX_TOKEN=your_mapbox_token_here
