# Data — PDFs are 20GB+, never commit (jurisdiction layer files are the carve-out)
data/*
!data/jurisdiction.schema.json
!data/jurisdictions/
# Boundary layer (Endeavor B): built GeoJSON + provenance, ~400 KB — the
# raw TIGER/DOLA downloads stay in data/raw/ (ignored).
!data/boundaries/

# Model weights
*.pt
*.onnx
*.engine
*.mlpackage
weights/

# Environment
.env
.env.*
# .env.example files are documentation templates with placeholder values,
# not real secrets — track them so contributors see the required vars.
!.env.example
!**/.env.example

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.venv/

# Notebooks
.ipynb_checkpoints/

# Label Studio
.label-studio/

# IDE
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Local rendering artifacts at repo root — PDF/XLSX/PNG outputs from
# scripts/render_test_pdfs.py and one-off render harnesses.  Scoped to
# root with a leading slash so subdirectories that intentionally hold
# such files (e.g. docs/) aren't affected.
/*.pdf
/*.xlsx
/preview_zoom_*.png
# Standalone TA-* render harnesses kept locally for visual debugging;
# the canonical harness lives at scripts/render_test_pdfs.py.
/render_ta*.py
# One-off Next.js harness scripts (e.g., verify_road_bearing.mjs).
conestruct/site/scripts/

# Node dependencies — anywhere in the tree (root harness installs and the
# Next.js app's own node_modules).
node_modules/

# Local validation/walkthrough harnesses and their render outputs (PDFs,
# screenshots, throwaway Playwright scripts) — kept on disk for debugging,
# never committed.  EXCEPT committed/: the tracked verification-evidence
# home (#160 ruling, 2026-07-30) — diff-verifier citations must point at
# tracked paths, and this is where they live.
validation-artifacts/*
!validation-artifacts/committed/

# Claude Code local workspace (settings, transcripts, scratch). Nothing in
# here is shared state — if a tracked, shared .claude/settings.json is ever
# wanted, add a `!.claude/settings.json` negation below this line.
.claude/

# Confidential working-knowledge files — read locally, never committed.
/CLAUDE.md
/memory.md
/handoff.md

# Design-tool export artifact (never committed)
design-bundle*
