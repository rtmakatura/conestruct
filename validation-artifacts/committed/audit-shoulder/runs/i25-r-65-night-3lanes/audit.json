    "notes": [
     {
      "rule": "Denver is entity-gated: Contractor Licensing issues licenses to work in the ROW (720-865-2770), and the Street Occupancy Request Form requires a Contractor's license number.",
      "source": {
       "doc": "DOTI PT-116.1",
       "date": "2022-04-01",
       "status": "verified"
      }
     },
     {
      "rule": "Fee-design interaction (Rule 22.3 §IV.4.f, §IV.6.b): (1) maintain a temporary PAR or bike facility in the adjacent parking/travel lane -> that lane's closure fee is WAIVED; (2) fail to maintain 5 ft unobstructed width -> charged the FULL LENGTH OF A BLOCK for the sidewalk/bike closure; (3) covered walkway used as a detour with no added crossings -> reduced closure fee. The engine computes exactly the widths that decide this.",
      "source": {
       "doc": "Rule 22.3",
       "section": "IV.4.f, IV.6.b",
       "date": "2022-04-22",
       "status": "verified"
      }
     },
     {
      "rule": "Bus stops: temporary relocation/closure requires written approval from BOTH the City Traffic Engineer and RTD; all accommodation costs on the Permittee.",
      "source": {
       "doc": "DOTI PT-116.1",
       "date": "2022-04-01",
       "status": "verified"
      }
     },
     {
      "rule": "Paid-parking closure -> separate parking meter permit obtained with the RSOP; meter head removal only by Transportation Operations, billed daily. Unauthorized permanent meter removal: fee = (total yearly meter revenue + citation revenue) x 15 — the largest penalty multiplier in the corpus (not renderable as a fixed meter).",
      "source": {
       "doc": "Rule 22.3",
       "section": "IV.7",
       "date": "2022-04-22",
       "status": "verified"
      }
     },
     {
      "rule": "Sheet requirements are the deepest in the corpus: the TCP must depict existing conditions (north arrow, speed limit, geometry, markings, lane assignments, curb lines, sidewalks, PAR, all light/utility/signal poles, all posted signage, bus stops, all parking meters and kiosks with counts, tree lawns, racks, drop boxes) plus proposed items and closure math (taper lengths, advance signage with type/placement/distances, arrow board, work zone length AND width, width of reduced travel lanes). Engine values + a site-survey layer.",
      "source": {
       "doc": "DOTI PT-116.1",
       "date": "2022-04-01",
       "status": "verified"
      }
     },
     {
      "rule": "Conflicting permits: first-submitted, first-served; coordination with existing permits required.",
      "source": {
       "doc": "Rule 22.3",
       "date": "2022-04-22",
       "status": "verified"
      }
     }
