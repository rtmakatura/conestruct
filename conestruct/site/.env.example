# Clerk auth — get these from https://dashboard.clerk.com -> your app -> API Keys
# Copy this file to .env.local and fill in REAL values. Never commit real keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx

# Clerk routing (defaults below match middleware.ts and the routes we created)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app

# Neon Postgres — get the pooled connection string from your neon.tech project dashboard
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require

# Clerk webhook signing secret — get this from https://dashboard.clerk.com -> Webhooks -> your endpoint -> Signing Secret
# Format: whsec_xxxxxxxxxxxxxxxxxxxx
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# Render service (FastAPI on Modal) — printed by `modal deploy modal_app.py`,
# secret must match the one stored in `modal secret create conestruct-render-secret`.
MODAL_RENDER_URL=https://rtmakatura--conestruct-render-fastapi-app.modal.run
MODAL_RENDER_SECRET=c96900958a9886a3ca446ed929827a7b51b0c7541021961c1ab4e8f534cb9b59

# Demo / auth toggle. Default (unset or anything other than "true") = demo mode:
# homepage is the generator, no Sign In / Save / org switcher, downloads go through
# the public /api/render/[kind] endpoint. Set to "true" to revive the gated flow
# (Sign In, Save plan, /app workbench, company-scoped downloads).
NEXT_PUBLIC_AUTH_UI=

# Mapbox — server-only token used by /api/geocode (address → lat/lng),
# /api/road-classify (Tilequery on streets-v8), and /api/distance (HQ
# geocode). Never prefix with NEXT_PUBLIC; the token must stay server-side.
# Create one at https://account.mapbox.com/access-tokens/ — the default
# public token works for geocoding + tilequery.
MAPBOX_TOKEN=pk.xxxxxxxxxxxxxxxxxxxx

# Sentry — error monitoring for the Next.js app. DSN is public (ships
# to the browser); auth token is build-time only (source-map upload).
# Both are set in Vercel for Production + Preview. See MONITORING.md.
NEXT_PUBLIC_SENTRY_DSN=https://xxxxxxxxxxxx@oxxxxxxxxxx.ingest.us.sentry.io/xxxxxxxxxxx
SENTRY_AUTH_TOKEN=

# Sentry verification flags. Both default OFF. Set to "1" only when
# re-verifying the integration via /debug/sentry-test; never in
# Production for normal operation. See MONITORING.md.
NEXT_PUBLIC_SENTRY_TEST=
SENTRY_TEST_ENABLED=
